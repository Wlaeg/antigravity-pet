{
  "antigravity-pet-sync": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook-bridge.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook-bridge.mjs",
        "timeout": 3
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook-bridge.mjs",
            "timeout": 48
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook-bridge.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook-bridge.mjs",
        "timeout": 3
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hook-bridge.mjs",
        "timeout": 3
      }
    ]
  }
}
